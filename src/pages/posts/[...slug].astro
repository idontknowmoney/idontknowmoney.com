---
import { render } from 'astro:content';
import EpisodeLayout from '../../layouts/EpisodeLayout.astro';
import { getEpisodes, getSocialPosts } from '../../lib/content';

export async function getStaticPaths() {
	const episodes = await getEpisodes();
	const social = await getSocialPosts();
	// `episodes` is newest first, so the next index is the previous episode.
	return episodes.map((episode, i) => ({
		params: { slug: episode.id },
		props: {
			episode,
			previous: episodes[i + 1],
			next: episodes[i - 1],
			social: social.filter((post) => post.data.episode?.id === episode.id),
		},
	}));
}

const { episode, previous, next, social } = Astro.props;
const { Content } = await render(episode);
---

<EpisodeLayout {episode} {previous} {next} {social}>
	<Content />
</EpisodeLayout>
