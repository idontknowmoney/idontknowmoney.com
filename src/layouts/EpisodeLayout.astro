---
import { AUTHOR, AUTHOR_INITIALS, SEASONS } from '../consts';
import SectionHeader from '../components/SectionHeader.astro';
import SocialCard from '../components/SocialCard.astro';
import Tag from '../components/Tag.astro';
import {
	epLabel,
	episodeHref,
	formatDate,
	readingTime,
	type Episode,
	type SocialPost,
} from '../lib/content';
import BaseLayout from './BaseLayout.astro';

interface Props {
	episode: Episode;
	previous?: Episode;
	next?: Episode;
	social: SocialPost[];
}

const { episode, previous, next, social } = Astro.props;
const { title, description, pubDate, updatedDate, topic, season, code, takeaway, minutes } =
	episode.data;
const mins = minutes ?? readingTime(episode.body);
---

<BaseLayout title={`${title} · I Don't Know Money (Yet)`} {description}>
	<article class="ik-sheet">
		<a class="ik-back" href="/posts/">
			← All posts
		</a>
		<header class="ik-article__head">
			<div class="ik-post__meta">
				<span class="ik-post__ep">{epLabel(episode.data.episode)}</span>
				<Tag>{topic}</Tag>
				<span class="ik-meta">
					Season {season}: {SEASONS[season]}
				</span>
			</div>
			<h1>{title}</h1>
			<p class="ik-article__lede">{description}</p>
			<div class="ik-byline">
				<span class="ik-avatar" aria-hidden="true">
					{AUTHOR_INITIALS}
				</span>
				<span>
					<strong>{AUTHOR}</strong>
					{' · '}
					<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
					{` · ${mins} min read`}
					{updatedDate && (
						<>
							{' · updated '}
							<time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
						</>
					)}
				</span>
				{code && (
					<a
						class="ik-btn ik-btn--link"
						style="margin-left:auto"
						href={code}
						target="_blank"
						rel="noopener"
					>
						Code on GitHub ↗
					</a>
				)}
			</div>
		</header>

		<div class="ik-prose">
			<slot />
			{takeaway && (
				<div class="ik-takeaway">
					<span class="ik-meta">Takeaway</span>
					<p>{takeaway}</p>
				</div>
			)}
			<p class="ik-note">
				Educational content, not investment advice. I'm learning in public; check my work in the
				repo.
			</p>
		</div>

		{social.length > 0 && (
			<section class="ik-discuss">
				<SectionHeader title="Discussed on social" />
				<div class="ik-grid-2">
					{social.map((post) => (
						<SocialCard {post} />
					))}
				</div>
			</section>
		)}

		<nav class="ik-pager" aria-label="Episodes">
			{previous ? (
				<a href={episodeHref(previous)}>
					<span class="ik-meta">← Previous · {epLabel(previous.data.episode)}</span>
					<span>{previous.data.title}</span>
				</a>
			) : (
				<span />
			)}
			{next && (
				<a href={episodeHref(next)}>
					<span class="ik-meta">Next · {epLabel(next.data.episode)} →</span>
					<span>{next.data.title}</span>
				</a>
			)}
		</nav>
	</article>
</BaseLayout>
